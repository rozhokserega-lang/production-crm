# Локальная БД (docker compose local-db). Скопируйте в fronted/.env.local когда Supabase Cloud недоступен.
# Данные: scripts/local-db-sync-prod.ps1
# Realtime + REST + Auth: scripts/local-db-up.ps1  |  Edge Functions: local-db-functions-serve.ps1

VITE_BACKEND_PROVIDER=supabase
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_DIRECT_URL=http://127.0.0.1:54321
# Стандартный anon JWT для локального стека (secret = super-secret-jwt-token-with-at-least-32-characters-long)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Прокси не нужен — REST уже на 127.0.0.1:54321
VITE_SUPABASE_PROXY_URL=

# Для pg_dump с прода (scripts/local-db-backup-prod.ps1), не коммитьте пароль:
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@...pooler.supabase.com:5432/postgres?sslmode=require
# Надёжнее для дампа (Direct connection в Supabase Dashboard):
# SUPABASE_DB_DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
